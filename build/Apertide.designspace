    </source>
    <source filename="Apertide-800-75.ufo" name="Apertide 800 75" familyname="Apertide" stylename="Condensed ExtraBold">
      <location>
        <dimension name="Weight" xvalue="800"/>
        <dimension name="Width" xvalue="75"/>
