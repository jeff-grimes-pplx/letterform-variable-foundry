    <source filename="Apertide-800-125.ufo" name="Apertide 800 125" familyname="Apertide" stylename="Extended ExtraBold">
      <location>
        <dimension name="Weight" xvalue="800"/>
        <dimension name="Width" xvalue="125"/>
      </location>
    </source>
  </sources>
  <instances>
