<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="Weight" minimum="200" maximum="800" default="400">
      <labels>
        <label uservalue="200" name="ExtraLight"/>
        <label uservalue="300" name="Light"/>
        <label uservalue="400" name="Regular" elidable="true" linkeduservalue="700"/>
        <label uservalue="500" name="Medium"/>
        <label uservalue="600" name="SemiBold"/>
        <label uservalue="700" name="Bold"/>
        <label uservalue="800" name="ExtraBold"/>
      </labels>
    </axis>
    <axis tag="wdth" name="Width" minimum="75" maximum="125" default="100">
      <labels>
        <label uservalue="75" name="Condensed"/>
        <label uservalue="100" name="Normal" elidable="true"/>
        <label uservalue="125" name="Extended"/>
      </labels>
    </axis>
  </axes>
  <sources>
    <source filename="Apertide-200-75.ufo" name="Apertide 200 75" familyname="Apertide" stylename="Condensed ExtraLight">
      <location>
        <dimension name="Weight" xvalue="200"/>
        <dimension name="Width" xvalue="75"/>
      </location>
    </source>
    <source filename="Apertide-200-100.ufo" name="Apertide 200 100" familyname="Apertide" stylename="ExtraLight">
      <location>
        <dimension name="Weight" xvalue="200"/>
        <dimension name="Width" xvalue="100"/>
      </location>
    </source>
    <source filename="Apertide-200-125.ufo" name="Apertide 200 125" familyname="Apertide" stylename="Extended ExtraLight">
      <location>
        <dimension name="Weight" xvalue="200"/>
        <dimension name="Width" xvalue="125"/>
      </location>
    </source>
    <source filename="Apertide-400-75.ufo" name="Apertide 400 75" familyname="Apertide" stylename="Condensed Regular">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Width" xvalue="75"/>
      </location>
    </source>
    <source filename="Apertide-400-100.ufo" name="Apertide 400 100" familyname="Apertide" stylename="Regular">
      <lib copy="1"/>
      <groups copy="1"/>
      <features copy="1"/>
      <info copy="1"/>
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Width" xvalue="100"/>
      </location>
    </source>
    <source filename="Apertide-400-125.ufo" name="Apertide 400 125" familyname="Apertide" stylename="Extended Regular">
      <location>
        <dimension name="Weight" xvalue="400"/>
        <dimension name="Width" xvalue="125"/>
